rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function chatOf(cid) { return get(/databases/$(db)/documents/chats/$(cid)).data; }
    function prefsOf(uid) { return exists(/databases/$(db)/documents/uprefs/$(uid)) ? get(/databases/$(db)/documents/uprefs/$(uid)).data : {}; }
    function callOk(to, cid, mode) {
      return prefsOf(to).get('calls', 'approved') != 'none'
        && (mode != 'video' || prefsOf(to).get('video', true) == true)
        && (prefsOf(to).get('calls', 'approved') == 'all'
            || (exists(/databases/$(db)/documents/chats/$(cid)/state/$(to))
                && get(/databases/$(db)/documents/chats/$(cid)/state/$(to)).data.get('allowCalls', false) == true));
    }
    function otherOf(cid) { return chatOf(cid).owner == request.auth.uid ? chatOf(cid).asker : chatOf(cid).owner; }
    function validAd(d) { return d.age is int && d.age >= 18 && d.age <= 80 && d.name is string && d.name.size() <= 40
      && d.about is string && d.about.size() <= 500 && d.g in ['kelin','kuyov'] && d.pur in ['oila','nikoh','tanish']; }
    // Eʼlon faqat telefon, shaxs va 18+ tekshiruvlari admin/provider tomonidan tasdiqlangandan keyin yaratiladi.
    function verifiedPublisher(uid) {
      return exists(/databases/$(db)/documents/verification/$(uid))
        && get(/databases/$(db)/documents/verification/$(uid)).data.status == 'approved'
        && get(/databases/$(db)/documents/verification/$(uid)).data.phoneVerified == true
        && get(/databases/$(db)/documents/verification/$(uid)).data.identityVerified == true
        && get(/databases/$(db)/documents/verification/$(uid)).data.selfieVerified == true
        && get(/databases/$(db)/documents/verification/$(uid)).data.ageVerified == true
        && get(/databases/$(db)/documents/verification/$(uid)).data.verifiedAge is int;
    }
    function member(gid) { return exists(/databases/$(db)/documents/groups/$(gid)/members/$(request.auth.uid)); }

    match /admins/{uid} { allow get: if signed() && request.auth.uid == uid; }
    match /settings/{id} { allow read: if signed(); allow write: if isAdmin(); }

    match /users/{uid} {
      // User profile documents are private: only the owner and admins can read them.
      allow get: if signed() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','phone','email','img','t','groups','prefs','favs','freeUsed'])
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.matches('^\\+[1-9][0-9]{7,14}$')));
      allow update: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','phone','email','img','t','groups','prefs','favs','freeUsed'])
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.matches('^\\+[1-9][0-9]{7,14}$')))
        && (!resource.data.get('freeUsed', false) || request.resource.data.get('freeUsed', false) == true);
      allow delete: if signed() && request.auth.uid == uid;
    }

    match /verification/{uid} {
      allow get: if signed() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Foydalanuvchi faqat tekshiruv soʻrovini ochishi mumkin; tasdiq maydonlarini oʻzi oʻzgartira olmaydi.
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','status','phoneVerified','identityVerified','selfieVerified','ageVerified','provider','createdAt','updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.status == 'pending'
        && request.resource.data.phoneVerified == true
        && request.resource.data.identityVerified == false
        && request.resource.data.selfieVerified == false && request.resource.data.ageVerified == false;
      allow update: if isAdmin() || (signed() && request.auth.uid == uid
        && resource.data.status == 'pending' && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phoneVerified','updatedAt'])
        && request.resource.data.phoneVerified == true);
      allow delete: if isAdmin();
    }

    match /ads/{id} {
      allow read: if true;
      allow create: if signed() && verifiedPublisher(request.auth.uid) && request.resource.data.uid == request.auth.uid
        && request.resource.data.age is int && request.resource.data.age >= 18 && request.resource.data.age <= 80
        && request.resource.data.age == get(/databases/$(db)/documents/verification/$(request.auth.uid)).data.verifiedAge
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.about is string && request.resource.data.about.size() <= 500
        && request.resource.data.g in ['kelin','kuyov'] && request.resource.data.pur in ['oila','nikoh','tanish']
        && request.resource.data.vip == false
        && ((request.resource.data.status == 'pending')
          || (request.resource.data.status == 'active'
              && !get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('freeUsed', false)
              && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('freeUsed', false) == true));
      allow create: if isAdmin() && request.resource.data.uid == request.auth.uid && validAd(request.resource.data);
      allow update: if isAdmin() || (signed() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','age','reg','vil','about','ava','img','ints','pur','g','anon','profileDetails'])
        && (!('profileDetails' in request.resource.data) || (request.resource.data.profileDetails is map && request.resource.data.profileDetails.keys().hasOnly(['housing','living','work','car','education'])))
        && validAd(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['age'])
          || (verifiedPublisher(request.auth.uid)
            && request.resource.data.age == get(/databases/$(db)/documents/verification/$(request.auth.uid)).data.verifiedAge)));
      allow delete: if signed() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /ads/{id}/priv/{d} {
      allow read, write: if signed() && get(/databases/$(db)/documents/ads/$(id)).data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /payments/{pid} {
      allow create: if signed() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000;
      allow read: if signed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
    match /auditLogs/{id} { allow create: if isAdmin() && request.resource.data.by == request.auth.uid; allow read: if isAdmin(); }
    match /reports/{id} {
      allow create: if signed() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by','t','reason','chat','ad','adName','adOwner'])
        && request.resource.data.t is int
        && (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 500))
        && (!('chat' in request.resource.data) || (request.resource.data.chat is string && request.resource.data.chat.size() <= 120))
        && (!('ad' in request.resource.data) || (request.resource.data.ad is string && request.resource.data.ad.size() <= 120))
        && (!('adName' in request.resource.data) || (request.resource.data.adName is string && request.resource.data.adName.size() <= 40))
        && (!('adOwner' in request.resource.data) || (request.resource.data.adOwner is string && request.resource.data.adOwner.size() <= 128));
      allow read, delete: if isAdmin();
    }
    match /priv/{uid} { allow read, write: if signed() && request.auth.uid == uid; }
    match /swipes/{id} {
      allow read: if signed() && resource.data.uid == request.auth.uid;
      allow create, update: if signed() && request.resource.data.uid == request.auth.uid;
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }

    match /chats/{cid} {
      allow get: if signed() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed() && request.resource.data.asker == request.auth.uid && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2 && request.resource.data.owner != request.auth.uid && request.resource.data.owner in request.resource.data.members
        && !exists(/databases/$(db)/documents/blocks/$(request.resource.data.owner + '_' + request.auth.uid));
      allow update: if signed() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members && request.resource.data.owner == resource.data.owner && request.resource.data.asker == resource.data.asker
        && (request.auth.uid == resource.data.owner || request.resource.data.photoOk == resource.data.photoOk);
      match /msgs/{mid} {
        allow read: if signed() && request.auth.uid in chatOf(cid).members;
        allow create: if signed() && request.auth.uid in chatOf(cid).members && request.resource.data.from == request.auth.uid
          && !exists(/databases/$(db)/documents/blocks/$(otherOf(cid) + '_' + request.auth.uid))
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && (request.resource.data.get('kind', '') != 'media'
            || (request.resource.data.mediaType == 'image'
              && request.resource.data.get('mediaProvider', '') == 'openinary'
              && request.resource.data.mediaPath is string
              && request.resource.data.mediaPath.size() <= 400
              && request.resource.data.mediaPath.matches('/?yaqin/users/' + request.auth.uid + '/private/.*')))
          && (request.resource.data.get('kind', '') != 'voice'
            || (request.resource.data.voiceId is string && request.resource.data.voiceId.size() <= 40
              && request.resource.data.dur is number && request.resource.data.dur <= 125))
          && (request.resource.data.get('reply', null) == null
            || (request.resource.data.reply is map && request.resource.data.reply.keys().hasOnly(['id', 'name', 'text', 'kind'])
              && request.resource.data.reply.id is string && request.resource.data.reply.text is string && request.resource.data.reply.text.size() <= 120));
        allow update: if signed() && request.auth.uid in chatOf(cid).members && resource.data.from == request.auth.uid
          && resource.data.get('deleted', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt', 'deleted'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && (request.resource.data.get('deleted', false) == true || resource.data.get('kind', '') == '');
      }
      match /state/{uid} {
        allow read: if signed() && request.auth.uid in chatOf(cid).members;
        allow write: if signed() && request.auth.uid == uid && request.auth.uid in chatOf(cid).members
          && request.resource.data.keys().hasOnly(['readMsg', 'readT', 'typing', 'allowCalls'])
          && (!('allowCalls' in request.resource.data) || request.resource.data.allowCalls is bool)
          && (!('readMsg' in request.resource.data) || (request.resource.data.readMsg is string && request.resource.data.readMsg.size() <= 40))
          && (!('readT' in request.resource.data) || request.resource.data.readT is int)
          && (!('typing' in request.resource.data) || request.resource.data.typing is int);
      }
      match /voice/{vid} {
        allow read: if signed() && request.auth.uid in chatOf(cid).members;
        allow create: if signed() && request.auth.uid in chatOf(cid).members && request.resource.data.from == request.auth.uid
          && !exists(/databases/$(db)/documents/blocks/$(otherOf(cid) + '_' + request.auth.uid))
          && request.resource.data.data is string && request.resource.data.data.size() <= 800000
          && request.resource.data.data[0:11] == 'data:audio/'
          && request.resource.data.dur is number && request.resource.data.dur > 0 && request.resource.data.dur <= 125;
      }
      match /shared/{d} {
        allow read: if signed() && request.auth.uid in chatOf(cid).members;
        allow write: if signed() && request.auth.uid == chatOf(cid).owner;
      }
    }

    match /calls/{id} {
      allow read: if signed() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signed() && (request.resource.data.from == request.auth.uid
          || (request.resource.data.from.matches('bot_.*') && request.resource.data.from in get(/databases/$(db)/documents/gamerooms/$(rid)).data.players))
        && request.resource.data.members.size() == 2 && request.resource.data.members.hasAll([request.auth.uid, request.resource.data.to])
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'ringing' && request.resource.data.mode in ['audio', 'video']
        && request.resource.data.chatId is string
        && chatOf(request.resource.data.chatId).members.hasAll(request.resource.data.members)
        && !exists(/databases/$(db)/documents/blocks/$(request.resource.data.to + '_' + request.auth.uid))
        && callOk(request.resource.data.to, request.resource.data.chatId, request.resource.data.mode);
      allow update: if signed() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt', 'acceptedAt'])
        && request.resource.data.status in ['ringing', 'accepted', 'declined', 'ended', 'missed'];
      // 1:1 qoʻngʻiroq WebRTC signali: faqat shu qoʻngʻiroqning ikki ishtirokchisi oʻrtasida
      match /rtc/{sid} {
        allow read: if signed() && request.auth.uid in get(/databases/$(db)/documents/calls/$(id)).data.members
          && resource.data.to == request.auth.uid;
        allow create: if signed() && request.auth.uid in get(/databases/$(db)/documents/calls/$(id)).data.members
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to in get(/databases/$(db)/documents/calls/$(id)).data.members
          && request.resource.data.type in ['offer','answer','cand','hello','vid']
          && request.resource.data.data is string && request.resource.data.data.size() <= 12000
          && request.resource.data.t is number;
        allow delete: if signed() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
    }

    match /gamerooms/{rid} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.owner == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 40
        && request.resource.data.players == [request.auth.uid]
        && request.resource.data.max >= 3 && request.resource.data.max <= 8;
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players','pm','turn','turnAt','spin','status','updatedAt','lj','humanLeftAt','voice'])
        && (request.auth.uid in resource.data.players
            || (request.auth.uid in request.resource.data.players && resource.data.status == 'open'
                && request.resource.data.players.size() <= resource.data.max));
      allow delete: if signed() && (request.auth.uid == resource.data.owner || isAdmin());
      match /chat/{mid} {
        allow read: if signed() && request.auth.uid in get(/databases/$(db)/documents/gamerooms/$(rid)).data.players;
        allow create: if signed() && request.auth.uid in get(/databases/$(db)/documents/gamerooms/$(rid)).data.players
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.t is number;
      }
      // WebRTC ovoz signali (offer/answer/ICE): faqat xona aʼzolari oʻrtasida, qabul qiluvchi oʻqiydi va oʻchiradi
      match /rtc/{sid} {
        allow read: if signed() && request.auth.uid in get(/databases/$(db)/documents/gamerooms/$(rid)).data.players
          && resource.data.to == request.auth.uid;
        allow create: if signed() && request.auth.uid in get(/databases/$(db)/documents/gamerooms/$(rid)).data.players
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to in get(/databases/$(db)/documents/gamerooms/$(rid)).data.players
          && request.resource.data.type in ['offer','answer','cand','hello','vid']
          && request.resource.data.data is string && request.resource.data.data.size() <= 12000
          && request.resource.data.t is number;
        allow delete: if signed() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
      match /gifts/{gid} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(db)/documents/gamerooms/$(rid)).data.players
          && request.resource.data.to in get(/databases/$(db)/documents/gamerooms/$(rid)).data.players
          && request.resource.data.kind in ['kiss','atirgul','lola','gul','guldasta'];
      }
    }

    match /groups/{gid} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.owner == request.auth.uid && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40 && request.resource.data.n == 1
        && request.resource.data.get('visibility', 'open') in ['open','closed'];
      allow update: if isAdmin() || (signed() && ((request.auth.uid == resource.data.owner
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility','visibilityUpdatedAt','mediaUploadMode','mediaPolicyAt']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n']) && (request.resource.data.n == resource.data.n + 1 || request.resource.data.n == resource.data.n - 1))));
      allow delete: if signed() && (request.auth.uid == resource.data.owner || isAdmin());
      match /members/{uid} {
        allow read: if signed();
        allow create: if signed() && request.auth.uid == uid
          && (isAdmin() || get(/databases/$(db)/documents/groups/$(gid)).data.owner == request.auth.uid
            || get(/databases/$(db)/documents/groups/$(gid)).data.get('visibility', 'closed') == 'open'
            || get(/databases/$(db)/documents/groups/$(gid)/joinRequests/$(uid)).data.status == 'approved');
        allow delete: if signed() && (request.auth.uid == uid
          || get(/databases/$(db)/documents/groups/$(gid)).data.owner == request.auth.uid);
      }
      match /voice/{vid} {
        allow read: if signed() && member(gid);
        allow create: if signed() && member(gid) && request.resource.data.from == request.auth.uid
          && request.resource.data.data is string && request.resource.data.data.size() <= 800000
          && request.resource.data.data[0:11] == 'data:audio/'
          && request.resource.data.dur is number && request.resource.data.dur > 0 && request.resource.data.dur <= 125;
      }
      match /msgs/{mid} {
        allow read: if signed() && (member(gid) || isAdmin());
        allow create: if signed() && member(gid) && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && (request.resource.data.get('reply', null) == null
            || (request.resource.data.reply is map && request.resource.data.reply.keys().hasOnly(['id', 'name', 'text', 'kind'])
              && request.resource.data.reply.id is string && request.resource.data.reply.text is string && request.resource.data.reply.text.size() <= 120))
          && (request.resource.data.get('kind', '') != 'voice'
            || (request.resource.data.voiceId is string && request.resource.data.voiceId.size() <= 40
              && request.resource.data.dur is number && request.resource.data.dur <= 125))
          && (request.resource.data.get('kind', '') != 'media'
            || (request.resource.data.mediaType in ['image','video']
              && ((request.resource.data.get('mediaProvider', '') == 'openinary'
                  && request.resource.data.mediaPath is string
                  && request.resource.data.mediaPath.size() <= 400
                  && request.resource.data.mediaPath.matches('/?yaqin/groups/' + gid + '/.*'))
                || (request.resource.data.get('mediaUrl', '') is string
                  && request.resource.data.get('mediaUrl', '').matches('https://firebasestorage.googleapis.com/.*')))
              && (get(/databases/$(db)/documents/groups/$(gid)).data.owner == request.auth.uid
                || get(/databases/$(db)/documents/groups/$(gid)).data.get('mediaUploadMode', 'owner') == 'members')))
          && ((!('visibleAt' in request.resource.data) && !('expiresAt' in request.resource.data))
            || (get(/databases/$(db)/documents/groups/$(gid)).data.get('premiumUntil', 0) > request.time.toMillis()
              && (!('visibleAt' in request.resource.data) || request.resource.data.visibleAt is int)
              && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is int)
              && (!('visibleAt' in request.resource.data && 'expiresAt' in request.resource.data) || request.resource.data.expiresAt > request.resource.data.visibleAt)));
        allow update: if signed() && member(gid) && resource.data.from == request.auth.uid
          && resource.data.get('deleted', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt', 'deleted'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && (request.resource.data.get('deleted', false) == true || resource.data.get('kind', '') == '');
        allow delete: if signed() && get(/databases/$(db)/documents/groups/$(gid)).data.owner == request.auth.uid;
      }
      match /joinRequests/{uid} {
        allow get: if signed() && (request.auth.uid == uid
          || get(/databases/$(db)/documents/groups/$(gid)).data.owner == request.auth.uid);
        allow list: if signed() && get(/databases/$(db)/documents/groups/$(gid)).data.owner == request.auth.uid;
        allow create: if signed() && request.auth.uid == uid
          && request.resource.data.uid == uid && request.resource.data.status == 'pending'
          && exists(/databases/$(db)/documents/groups/$(gid));
        allow update: if signed() && (
          (get(/databases/$(db)/documents/groups/$(gid)).data.owner == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['approved','rejected']
            && request.resource.data.uid == resource.data.uid)
          || (request.auth.uid == uid && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.uid == uid));
        allow delete: if signed() && (request.auth.uid == uid
          || get(/databases/$(db)/documents/groups/$(gid)).data.owner == request.auth.uid);
      }
    }


    match /groupCalls/{gid} {
      allow get: if signed() && member(gid);
      allow list: if signed() && member(gid);
      allow create: if signed() && member(gid)
        && get(/databases/$(db)/documents/groups/$(gid)).data.get('premiumUntil', 0) > request.time.toMillis()
        && request.resource.data.gid == gid && request.resource.data.owner == request.auth.uid
        && request.resource.data.mode in ['audio','video'] && request.resource.data.active == true;
      allow update: if signed() && member(gid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','endedAt']) && request.resource.data.active == false)
        || (!resource.data.active && request.resource.data.active == true
          && get(/databases/$(db)/documents/groups/$(gid)).data.get('premiumUntil', 0) > request.time.toMillis()
          && request.resource.data.gid == gid && request.resource.data.owner == request.auth.uid
          && request.resource.data.mode in ['audio','video'] && request.resource.data.startedAt is int));
      allow delete: if signed() && member(gid) && request.auth.uid == resource.data.owner;
      match /participants/{uid} {
        allow read: if signed() && member(gid);
        allow create, update: if signed() && request.auth.uid == uid && member(gid)
          && get(/databases/$(db)/documents/groups/$(gid)).data.get('premiumUntil', 0) > request.time.toMillis()
          && request.resource.data.uid == uid && request.resource.data.mode in ['audio','video'];
        allow delete: if signed() && request.auth.uid == uid && member(gid);
      }
      // Guruh qoʻngʻirogʻi WebRTC signali (ovoz/video): faqat guruh aʼzolari oʻrtasida
      match /rtc/{sid} {
        allow read: if signed() && member(gid) && resource.data.to == request.auth.uid;
        allow create: if signed() && member(gid)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && exists(/databases/$(db)/documents/groups/$(gid)/members/$(request.resource.data.to))
          && request.resource.data.type in ['offer','answer','cand','hello','vid']
          && request.resource.data.data is string && request.resource.data.data.size() <= 12000
          && request.resource.data.t is number;
        allow delete: if signed() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
      match /signals/{sid} {
        allow read: if signed() && member(gid);
        allow create: if signed() && member(gid)
          && get(/databases/$(db)/documents/groups/$(gid)).data.get('premiumUntil', 0) > request.time.toMillis()
          && request.resource.data.caller == request.auth.uid
          && request.resource.data.callee is string
          && exists(/databases/$(db)/documents/groups/$(gid)/members/$(request.resource.data.callee))
          && request.resource.data.offer.sdp is string;
        allow update: if signed() && member(gid) && (
          (request.auth.uid == resource.data.caller
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready'])
            && request.resource.data.ready == true)
          || (request.auth.uid == resource.data.callee
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','answeredAt'])
            && request.resource.data.answer.sdp is string));
        allow delete: if signed() && member(gid)
          && (request.auth.uid == resource.data.caller || request.auth.uid == resource.data.callee);
        match /candidates/{cid} {
          allow read: if signed() && member(gid);
          allow create: if signed() && member(gid)
            && request.resource.data.from == request.auth.uid
            && (request.auth.uid == get(/databases/$(db)/documents/groupCalls/$(gid)/signals/$(sid)).data.caller
              || request.auth.uid == get(/databases/$(db)/documents/groupCalls/$(gid)/signals/$(sid)).data.callee)
            && request.resource.data.candidate is map;
          allow update, delete: if false;
        }
      }
    }

    match /notifs/{id} {
      allow read: if signed() && resource.data.to == request.auth.uid;
      allow create: if signed() && request.resource.data.to is string
        && (isAdmin() || (request.resource.data.type == 'like' && request.resource.data.from == request.auth.uid && request.resource.data.to != request.auth.uid));
      allow update: if signed() && resource.data.to == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signed() && resource.data.to == request.auth.uid;
    }
    match /support/{uid} {
      allow get: if signed() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signed() && ((request.auth.uid == uid && request.resource.data.lastBy == 'user' && request.resource.data.uid == uid) || isAdmin());
      match /msgs/{mid} {
        allow read: if signed() && (request.auth.uid == uid || isAdmin());
        allow create: if signed() && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && ((request.auth.uid == uid && request.resource.data.from == 'user') || (isAdmin() && request.resource.data.from == 'admin'));
      }
    }

    match /blocks/{id} {
      allow create: if signed() && request.resource.data.by == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.to;
      allow read: if signed() && (resource.data.by == request.auth.uid || resource.data.to == request.auth.uid);
      allow delete: if signed() && resource.data.by == request.auth.uid;
    }
    match /fcm/{uid} { allow read, write: if signed() && request.auth.uid == uid; }
    match /uprefs/{uid} {
      allow read: if signed();
      allow write: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['calls', 'video', 'rr', 'typ'])
        && (!('calls' in request.resource.data) || request.resource.data.calls in ['none', 'approved', 'all'])
        && (!('video' in request.resource.data) || request.resource.data.video is bool)
        && (!('rr' in request.resource.data) || request.resource.data.rr is bool)
        && (!('typ' in request.resource.data) || request.resource.data.typ is bool);
    }
  }
}
